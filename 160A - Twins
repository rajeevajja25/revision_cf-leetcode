#include<bits/stdc++.h>
using namespace std;
int main(){
 ios::sync_with_stdio(false);
 cin.tie(nullptr);
 int n;
 cin>>n;
 vector<int>a(n); 
 for(int i=0;i<n;i++){
  cin>>a[i];
}
 
int sum=0;
 
for(int i=0;i<n;i++){
  sum+=a[i];
 
 }
sort(a.rbegin(),a.rend());
 
int mysum=0;
for(int i=0;i<n;i++){
  mysum+=a[i];
  if(mysum>sum/2){
   cout<<i+1;
   break;
 
  }
  
  
 
 }
return 0;
 
}
